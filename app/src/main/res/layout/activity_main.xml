<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121824"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tiêu đề Demo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B2A38"
        android:padding="12dp"
        android:text="DEMO: CARDVIEW (CARD UI)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Giao diện Thẻ Nổi 3D trong Ứng Dụng"
        android:textColor="#CCCCCC"
        android:textSize="14sp" />

    <!-- THẺ CARDVIEW CHÍNH -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:contentPadding="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 1. Thông tin trường -->
            <TextView
                android:id="@+id/tvSchool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="THẺ SINH VIÊN HCMUTE"
                android:textColor="#4ADE80"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/cardGpa"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 2. Khoa -->
            <TextView
                android:id="@+id/tvFaculty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Khoa Công Nghệ Thông Tin"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/cardGpa"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSchool" />

            <!-- 3. Khối GPA hình tròn bên phải -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGpa"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGpa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.85"
                        android:textColor="#FACC15"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPA"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Họ tên sinh viên -->
            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Họ và tên: Nguyễn Vũ Hoàng Ngân"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFaculty" />

            <!-- 5. MSSV và Lớp -->
            <TextView
                android:id="@+id/tvMssvClass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="MSSV: 2415141122112  • Lớp: 24SK1"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStudentName" />

            <!-- 6. Khối kết quả đạt được -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#0F172A"
                android:orientation="vertical"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMssvClass">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KẾT QUẢ ĐẠT ĐƯỢC:"
                    android:textColor="#60A5FA"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="XUẤT SẮC (Top 5% Khóa)"
                    android:textColor="#FACC15"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>